START TRANSACTION;

-- Vorher zur Kontrolle anzeigen
SELECT
    q.question_id,
    q.question_type,
    q.start_text AS old_start_text,
    ao.option_text AS misplaced_question_in_answer1
FROM question q
JOIN answer_option ao
  ON ao.question_id = q.question_id
 AND ao.option_order = 1
WHERE q.question_id IN (13, 24, 27, 31, 35, 38, 41, 45, 46, 49)
ORDER BY q.question_id;

-- 1) Fragetext aus Antwort 1 an den start_text anhängen
UPDATE question q
JOIN answer_option ao
  ON ao.question_id = q.question_id
 AND ao.option_order = 1
SET q.start_text = CONCAT(
    TRIM(q.start_text),
    ' ',
    TRIM(ao.option_text)
)
WHERE q.question_id IN (13, 24, 27, 31, 35, 38, 41, 45, 46, 49);

-- 2) Die verrutschte Antwort 1 löschen
DELETE FROM answer_option
WHERE question_id IN (13, 24, 27, 31, 35, 38, 41, 45, 46, 49)
  AND option_order = 1;

-- 3) Restliche Antworten um 1 nach vorne schieben
UPDATE answer_option
SET option_order = option_order - 1
WHERE question_id IN (13, 24, 27, 31, 35, 38, 41, 45, 46, 49)
  AND option_order > 1;

-- Nachher zur Kontrolle anzeigen
SELECT
    q.question_id,
    q.question_type,
    q.start_text AS new_start_text,
    ao.option_order,
    ao.option_text
FROM question q
JOIN answer_option ao
  ON ao.question_id = q.question_id
WHERE q.question_id IN (13, 24, 27, 31, 35, 38, 41, 45, 46, 49)
ORDER BY q.question_id, ao.option_order;

COMMIT;

