-- Vorschau: Was würde geändert?
SELECT
    'answer_option' AS table_name,
    answer_id AS row_id,
    question_id,
    option_order,
    option_text AS old_text,
    REGEXP_REPLACE(option_text, '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*', '') AS new_text
FROM answer_option
WHERE option_text REGEXP '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*'

UNION ALL

SELECT
    'gap_option' AS table_name,
    gap_option_id AS row_id,
    gf.question_id,
    go.option_order,
    go.option_text AS old_text,
    REGEXP_REPLACE(go.option_text, '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*', '') AS new_text
FROM gap_option go
JOIN gap_field gf
  ON gf.gap_id = go.gap_id
WHERE go.option_text REGEXP '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*';

-- Wenn die Vorschau gut aussieht: Präfixe in answer_option entfernen
UPDATE answer_option
SET option_text = REGEXP_REPLACE(
    option_text,
    '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*',
    ''
)
WHERE option_text REGEXP '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*';

-- Präfixe in gap_option entfernen
UPDATE gap_option
SET option_text = REGEXP_REPLACE(
    option_text,
    '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*',
    ''
)
WHERE option_text REGEXP '^[[:space:]]*[A-Za-zÄÖÜäöüß][\\)\\.:][[:space:]]*';

COMMIT;

